#!/usr/bin/env python

Import("env")
Import("env_modules")

env_etcpak = env_modules.Clone()
env_etcpak.Prepend(CPPPATH=["#thirdparty/etcpak"])
env_etcpak.add_source_files(env.modules_sources, "*.cpp")

env_thirdparty = env_etcpak.Clone()
env_thirdparty.disable_warnings()
env_thirdparty.add_source_files(
    env.modules_sources, ["#thirdparty/etcpak/DecodeRGB.cpp", "#thirdparty/etcpak/Tables.cpp"]
)
