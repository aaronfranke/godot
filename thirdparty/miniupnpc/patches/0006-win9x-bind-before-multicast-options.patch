 #else  /* _WIN32 */
@@ -756,6 +763,7 @@
 			/* not a fatal error */
 			PRINT_SOCKET_ERROR("setsockopt(IP_MULTICAST_TTL,...)");
 		}
+#endif /* !WIN_9X_ENABLED */
