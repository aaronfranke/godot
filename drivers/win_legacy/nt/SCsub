#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

env.add_source_files(env.drivers_sources, "*.cpp")
env.add_source_files(env.drivers_sources, "os/*.cpp")
env.add_source_files(env.drivers_sources, "#drivers/windows/file_access_windows_pipe.cpp")

if env["win_legacy_windowed"]:
    env.add_source_files(env.drivers_sources, "display/*.cpp")
    # NativeMenuWindows requires Windows 2000's SetMenuInfo/GetMenuInfo.
    if env["target_win_version_int"] >= 0x0500:
        env.add_source_files(env.drivers_sources, "#platform/windows/native_menu_windows.cpp")

if env["opengl3"]:
    env.add_source_files(env.drivers_sources, "display/opengl/*.cpp")
