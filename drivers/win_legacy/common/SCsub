#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

if env["platform"] in ("win_nt4", "win_nt5", "win_nt6"):
    env.add_source_files(env.drivers_sources, "#drivers/windows/net_socket_winsock.cpp")

    if env["win_legacy_windowed"]:
        env.add_source_files(env.drivers_sources, "audio/*.cpp")
        env.add_source_files(env.drivers_sources, "input/*.cpp")
        env.add_source_files(env.drivers_sources, "display/*.cpp")
        env.add_source_files(env.drivers_sources, "#platform/windows/key_mapping_windows.cpp")

    if env["d3d7"] or env["d3d9"] or env.get("opengl1", False) or env.get("d3d3_software", False):
        env.add_source_files(env.drivers_sources, "#platform/windows/fixed_function/fixed_function_windows.cpp")
