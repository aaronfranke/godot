#!/usr/bin/env python

Import("env", "prog")

# This SDK-only launcher forwards console streams to the GUI executable.
env_wrap = env.Clone()
if env.msvc:
    env_wrap["LINKFLAGS"].remove("/SUBSYSTEM:WINDOWS")
    env_wrap.Append(LINKFLAGS=["/SUBSYSTEM:CONSOLE"])
    env_wrap.Replace(LIBS=[])
else:
    env_wrap["LINKFLAGS"].remove("-mwindows")
    env_wrap.Append(LINKFLAGS=["-mconsole"])
    env_wrap.Replace(LIBS=["kernel32", "user32"])

sources = []
env_wrap.add_source_files(sources, "*.cpp")
suffix = env["PROGSUFFIX"]
wrapper = env_wrap.add_program("#bin/godot", sources, PROGSUFFIX=suffix[:-4] + ".console.exe")
env_wrap.Depends(wrapper, prog)
