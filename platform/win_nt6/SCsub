#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

sources = []
env.add_source_files(sources, "*.cpp")
env.add_source_files(sources, "os/*.cpp")
env.add_source_files(sources, "runtime/*.cpp")
if env["win_legacy_windowed"]:
    env.add_source_files(sources, "display/*.cpp")

if env.msvc:
    # The CRT import slot has a different COFF symbol spelling on each architecture.
    env.Tool("masm")
    if env["arch"] == "x86_32":
        env.Append(ASFLAGS=["/safeseh"])
        env.add_source_files(sources, "runtime/runtime_windows_nt6_x86.asm")
    else:
        env["AS"] = "ml64"
        env.add_source_files(sources, "runtime/runtime_windows_nt6_x64.asm")

prog = env.add_program("#bin/godot", sources, PROGSUFFIX=env["PROGSUFFIX"])

if env["win_legacy_windowed"]:
    SConscript("#drivers/win_legacy/common/launcher/SCsub", exports=["env", "prog"])
